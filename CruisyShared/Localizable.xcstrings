    "Il telefono è %lld ore %@ rispetto all'ora di bordo. Gli orari qui sono in ora di bordo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone is %1$lld hours %2$@ ship's time. Times here are in ship's time."
