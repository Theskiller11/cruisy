    "Correggi nave, orari e ora di bordo, o reimporta l'itinerario" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correct the ship, the times and ship's time, or import the itinerary again"
