        }
      }
    },
    "Corretto da te" : {
      "comment" : "Campo Orario del biglietto",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrected by you"
          }
        }
      }
    },
    "Cosa ha letto Cruisy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What Cruisy read"
          }
        }
