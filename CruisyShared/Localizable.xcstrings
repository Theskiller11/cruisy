            "value" : "Reading the document…"
          }
        }
      }
    },
    "Lo faccio più tardi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'll do it later"
          }
        }
      }
    },
    "Lunghezza" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Length"
          }
        }
      }
    },
    "MMSI (facoltativo)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MMSI (optional)"
          }
        }
      }
    },
    "Manca il permesso «Sempre». Senza, la rotta si registra solo mentre l'app è aperta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The “Always” permission is missing. Without it, the route is recorded only while the app is open."
          }
        }
      }
    },
    "Manca un giorno all'imbarco" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One day to boarding"
          }
        }
      }
    },
    "Manca un giorno alla partenza" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One day to departure"
          }
        }
      }
