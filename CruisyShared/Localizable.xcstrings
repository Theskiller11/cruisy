    "Prenderai «%@» con %lld scali. La crociera che hai adesso, e le correzioni che le hai fatto, andranno perse." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll take “%1$@” with %2$lld ports of call. The cruise you have now, and the corrections you made to it, will be lost."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prenderai «%1$@» con %2$lld scali. La crociera che hai adesso, e le correzioni che le hai fatto, andranno perse."
          }
        }
      }
    },
