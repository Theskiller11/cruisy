    "All'andatura di queste ore arriverete a %@ verso le %@, %@ dopo l'orario pubblicato. Gli orari che contano restano quelli annunciati a bordo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At the pace of the last few hours you'll reach %1$@ around %2$@, %3$@ after the published time. The times that count are still the ones announced on board."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All'andatura di queste ore arriverete a %1$@ verso le %2$@, %3$@ dopo l'orario pubblicato. Gli orari che contano restano quelli annunciati a bordo."
          }
        }
      }
    },
