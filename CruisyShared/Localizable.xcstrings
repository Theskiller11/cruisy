    },
    "Stanotte alle %@ l'orologio di bordo torna indietro di %@. Guadagni un'ora: gli orari di domani non cambiano, cambia l'orologio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight at %1$@ the ship's clock goes back %2$@. You gain time: tomorrow's times don't change, the clock does."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stanotte alle %1$@ l'orologio di bordo torna indietro di %2$@. Guadagni un'ora: gli orari di domani non cambiano, cambia l'orologio."
          }
        }
      }
    },
    "Stanotte alle %@ l'orologio di bordo va avanti di %@. Dormirai di meno: la sveglia del telefono non si sposta da sola." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonight at %1$@ the ship's clock goes forward %2$@. You'll sleep less: your phone's alarm won't move by itself."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stanotte alle %1$@ l'orologio di bordo va avanti di %2$@. Dormirai di meno: la sveglia del telefono non si sposta da sola."
          }
        }
