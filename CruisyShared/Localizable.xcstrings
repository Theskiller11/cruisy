            "state" : "translated",
            "value" : "Data"
          }
        }
      }
    },
    "Dati da Wikidata, di pubblico dominio. Le fotografie vengono da Wikimedia Commons e restano dei rispettivi autori." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data from Wikidata, in the public domain. Photographs come from Wikimedia Commons and remain their authors' own."
          }
        }
      }
    },
