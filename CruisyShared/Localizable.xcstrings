          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow the ports"
          }
        }
      }
    },
    "Sei a %@ dalla nave" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
